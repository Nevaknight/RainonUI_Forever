package-as: RainonUI_Forever
enable-nolib-creation: no
manual-changelog:
  filename: Changelog.md
  markup-type: markdown
ignore:
  - CrateData.lua
  - Crates.lua
  - LocalData.lua
  - Junk.lua
  - LocalTests.lua
  - QuestNavigationTest.lua
  - QuestNavigationTest.xml
  - Archive
  - Mooncloth.lua
  - WaylaidTest.lua
  - WaylaidTestData.lua
  - BoatRoutes.lua
  - DungeonLootPreview.lua
  - AGENTS.md
  - .gitignore
  - .gitattributes
  - .claude
  - .codex
  - .agents
  - CLAUDE.md
  - _to_delete
  - README.md
  - WTF
  - SavedVariables
  - RainonUI.lua
  - RainonUI_Forever.lua
  - session-notes.md
  - _FIX_IT_ADDON.md
  - _WIKI
  - _INDEX
  - Backup
  - Backups
  - Media/AGENTS.md
  - Media/CLAUDE.md
