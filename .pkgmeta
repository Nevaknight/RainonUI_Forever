package-as: RainonUI_Forever
enable-nolib-creation: no
manual-changelog:
  filename: Changelog.md
  markup-type: markdown
externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: 1.0
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibSharedMedia-3.0:
    url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
ignore:
  - CrateData.lua
  - Crates.lua
  - LocalData.lua
  - LocalTests.lua
  - ActivityTests.lua
  - QuestNavigationTest.lua
  - QuestNavigationTest.xml
  - Archive
  - Mooncloth.lua
  - WaylaidTest.lua
  - WaylaidTestData.lua
  - BoatRoutes.lua
  - DungeonLootPreview.lua
  - AGENTS.md
  - .gitignore
  - .gitattributes
  - .claude
  - .codex
  - .agents
  - CLAUDE.md
  - _to_delete
  - README.md
  - WTF
  - SavedVariables
  - RainonUI.lua
  - RainonUI_Forever.lua
  - session-notes.md
  - _FIX_IT_ADDON.md
  - _WIKI
  - _INDEX
  - Backup
  - Backups
  - Media/AGENTS.md
  - Media/CLAUDE.md
  - Media/ExpresswayLocal.TTF
