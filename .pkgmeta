package-as: RainonUI_Forever
enable-nolib-creation: no
manual-changelog:
  filename: Changelog.md
  markup-type: markdown
ignore:
  - CrateData.lua
  - Crates.lua
  - LocalData.lua
  - Junk.lua
  - Archive
  - Mooncloth.lua
  - WaylaidTest.lua
  - WaylaidTestData.lua
  - BoatRoutes.lua
  - DungeonLootPreview.lua
  - AGENTS.md
  - .gitignore
  - .gitattributes
  - .claude
  - .codex
  - .agents
  - CLAUDE.md
  - _to_delete
  - README.md
